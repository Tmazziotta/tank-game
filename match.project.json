{
  "name": "tank-game-match",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$path": "remotes/Remotes.model.json"
      }
    },
    "ServerScriptService": {
      "Core": {
        "$path": "src/core"
      },
      "Vendor": {
        "$className": "Folder",
        "ProfileStore": {
          "$path": "vendor/ProfileStore.luau"
        }
      },
      "Match": {
        "$path": "src/match/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Match": {
          "$path": "src/match/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Tanks": {
        "$className": "Folder"
      },
      "Wrecks": {
        "$className": "Folder"
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            512,
            20,
            512
          ]
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    }
  }
}
