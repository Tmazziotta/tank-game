{
  "name": "tank-game-garage",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$path": "remotes/Remotes.model.json"
      }
    },
    "ServerScriptService": {
      "Core": {
        "$path": "src/core"
      },
      "Vendor": {
        "$className": "Folder",
        "ProfileStore": {
          "$path": "vendor/ProfileStore.luau"
        }
      },
      "Garage": {
        "$path": "src/garage/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Garage": {
          "$path": "src/garage/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    }
  }
}
